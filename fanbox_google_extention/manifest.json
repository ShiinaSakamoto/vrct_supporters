{
  "manifest_version": 3,
  "name": "VRCT FANBOX Supporter Highlighter & Exporter",
  "version": "1.0.0",
  "description": "FANBOXの支援金詳細ページで各支援者行をプラン別にハイライトし、Patreon互換CSVをダウンロードします。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.fanbox.cc/manage/pledges/monthly/*",
        "*://*.fanbox.cc/manage/pledges/monthly/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
